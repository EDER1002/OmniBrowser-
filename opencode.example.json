{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "args": [
        "--config",
        "./mcp-firefox-config.json"
      ],
      "enabled": true
    },
    "vscode-runner": {
      "type": "local",
      "command": [
        "npx",
        "vscode-code-runner-mcp-server"
      ],
      "enabled": true
    }
  }
}