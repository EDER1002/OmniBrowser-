{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "omnibrowser-firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config",
          "/ABSOLUTE/PATH/TO/omnibrowser/mcp-firefox-config.json"
        ],
        "disabled": true
      },
      "omnibrowser-brave": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config",
          "/ABSOLUTE/PATH/TO/omnibrowser/mcp-brave-config.json"
        ],
        "disabled": true
      },
      "omnibrowser-opera": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config",
          "/ABSOLUTE/PATH/TO/omnibrowser/mcp-opera-config.json"
        ],
        "disabled": true
      },
      "omnibrowser-chrome": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config",
          "/ABSOLUTE/PATH/TO/omnibrowser/mcp-chrome-config.json"
        ],
        "disabled": true
      },
      "omnibrowser-chromium": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config",
          "/ABSOLUTE/PATH/TO/omnibrowser/mcp-chromium-config.json"
        ],
        "disabled": true
      }
    }
  }
}
